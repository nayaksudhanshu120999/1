<Window
    x:Class="QuickPalette.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="QuickPalette">
    <Grid
        RequestedTheme="Dark"
        Background="#FF111318"
        Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="4,0,0,16"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#FF969BA6"
            Text="QUICKPALETTE" />

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            Height="56"
            Padding="16,0"
            FontSize="20"
            PlaceholderText="Search apps or the web..."
            TextChanged="SearchBox_TextChanged"
            KeyDown="SearchBox_KeyDown" />

        <ScrollViewer
            Grid.Row="2"
            Margin="0,14,0,8"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel" Spacing="6" />
        </ScrollViewer>

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#FF888D98"
                Text="Apps from your Start menu" />
            <Button
                x:Name="WebSearchButton"
                Padding="12,6"
                Click="WebSearch_Click"
                Content="Search the web"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
